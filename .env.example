# Ключ ProxyAPI. Если его нет, используется OPENAI_API_KEY.
PROXYAPI_API_KEY=
# OPENAI_API_KEY=

# Необязательно. По умолчанию можно указать https://api.proxyapi.ru/v1
OPENAI_BASE_URL=https://api.proxyapi.ru/v1

# Необязательно. Значения по умолчанию уже подходят для ProxyAPI.
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Необязательно. Другое имя той же настройки: PINECONE_INDEX
# PINECONE_INDEX=
# Необязательно. Namespace в индексе Pinecone.
# PINECONE_NAMESPACE=
# Для hay/ (Haystack PineconeDocumentStore). По умолчанию 1536 для text-embedding-3-small.
# PINECONE_DIMENSION=1536
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
